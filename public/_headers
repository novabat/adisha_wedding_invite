# Cloudflare Pages response headers — https://developers.cloudflare.com/pages/configuration/headers/

# Images and fonts have content-hashed names, so they never change: cache for a year.
/assets/*
  Cache-Control: public, max-age=31536000, immutable

# The page runtime rarely changes: cache for a day.
/_runtime/*
  Cache-Control: public, max-age=86400
